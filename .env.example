# AccessAI Environment Configuration Template

# Server Configuration
NODE_ENV=production
PORT=3000

# Persistent Storage Directory (optional, defaults to ./data)
# DATA_DIR=/var/data

# Google Gemini API Key (optional, enables AI-powered remediation)
# GEMINI_API_KEY=your_gemini_api_key_here

# Path to Chromium browser binary (optional, automatically detected on Linux/Windows)
# CHROMIUM_PATH=/usr/bin/chromium
